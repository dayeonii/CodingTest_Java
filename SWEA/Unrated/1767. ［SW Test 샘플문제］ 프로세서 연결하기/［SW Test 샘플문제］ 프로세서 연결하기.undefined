import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.StringTokenizer;

public class Solution {

	static int N;
	static int maxConnected;
	static int minLen;
	static List<Core> cores;
	static int map[][];
	
	static int[][] delta = { {-1,0}, {1,0}, {0,-1}, {0,1} };

	static class Core {
		int r;
		int c;

		Core(int r, int c) {
			this.r = r;
			this.c = c;
		}
	}

	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringBuffer sb = new StringBuffer();

		int T = Integer.parseInt(br.readLine());
		for (int tc = 1; tc <= T; tc++) {
			// 맵 정보 받기
			N = Integer.parseInt(br.readLine());
			map = new int[N][N];
			cores = new ArrayList<>();

			for (int i = 0; i < N; i++) {
				StringTokenizer st = new StringTokenizer(br.readLine());
				for (int j = 0; j < N; j++) {
					map[i][j] = Integer.parseInt(st.nextToken());

					if (i > 0 && i < N - 1 && j > 0 && j < N - 1) {
						if (map[i][j] == 1) {
							cores.add(new Core(i, j));
						}
					}
				}
			}

			// dfs
			maxConnected = 0;
			minLen = Integer.MAX_VALUE;
			dfs(0, 0, 0);

			// 결과 출력
			sb.append('#').append(tc).append(' ').append(minLen).append('\n');
		}
		System.out.print(sb);
	}

	private static void dfs(int idx, int connected, int length) {
		// 종료 조건
		if (idx == cores.size()) {
			// 갱신해주고
			if (connected > maxConnected) {
				maxConnected = connected;
				minLen = length;
			} else if (connected==maxConnected){
				minLen = Math.min(minLen, length);
			}
			// 종료
			return;
		}

		// 다음 선택 후보군에 대한 루프
		Core current = cores.get(idx);
		for(int i=0; i<4; i++) {
			if(canGo(current.r, current.c, i)) {
				int len = setWire(current.r, current.c, i, 2);		
				dfs(idx+1, connected+1, length+len);
				setWire(current.r, current.c, i, 0);
			}
		}
		
		// 연결하지 않는 경우
		dfs(idx+1, connected, length);
	}

	private static boolean canGo(int r, int c, int dir) {
		int nr = r + delta[dir][0];
		int nc = c + delta[dir][1];
		
		while(nr>=0 && nr<N && nc>=0 && nc<N) {
			if(map[nr][nc]!=0) {
				return false;
			}
			nr+=delta[dir][0];
			nc+=delta[dir][1];
		}
		return true;
	}

	private static int setWire(int r, int c, int dir, int type) {
		int nr = r + delta[dir][0];
		int nc = c + delta[dir][1];
		int len = 0;
		
		while(nr>=0 && nr<N && nc>=0 && nc<N) {
			map[nr][nc] = type;
			len++;
			
			nr+=delta[dir][0];
			nc+=delta[dir][1];
		}
		return len;
	}

}
